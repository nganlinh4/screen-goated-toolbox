  "preparedWorkspaces": 4,
  "maximumConcurrentPreparations": 1,
  "request": {
    "required": [
      "jobId",
      "tool",
      "operation",
      "imagePaths",
      "prompt",
      "outputPath",
      "outputName"
    ],
    "prompt": {
      "trimmed": true,
      "minimumCharacters": 1,
      "maximumCharacters": 4000
    },
    "references": {
      "minimum": 0,
      "maximum": 20,
      "ordered": true,
      "frozenBeforeQueue": true
    },
    "frozenBeforeQueue": true,
    "multipleInputsCreateIndependentJobs": false,
    "oneSessionCreatesOneJob": true,
    "plusCreatesEmptySession": true
  },
  "submission": {
