    "appSpecificTheme": false,
    "lightAndDark": true,
    "reducedMotion": true,
    "transparentCanvas": true,
    "preserveSourceIntrinsicRatio": true,
    "textOnlyResultUsesOutputOnlyLayout": true,
    "multipleReferencesUseOrderedReferenceLayout": true,
    "focusedInputSurvivesStatusPolling": true,
