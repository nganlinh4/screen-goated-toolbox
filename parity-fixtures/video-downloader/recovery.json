{
  "schemaVersion": 1,
  "commandIsolation": {
    "ignoreUserConfiguration": true,
    "disableUserPluginDirectories": true,
    "managedJavaScriptRuntime": true,
    "managedChallengeScripts": true,
    "endOptionsBeforeUrl": true
  },
  "analysisIsOptional": true,
  "failure": {
    "preserveBoundedToolError": true,
    "refreshSource": "signed-component-catalog",
    "retryOnlyWhenIdentityChanges": true,
    "maximumRetries": 1,
    "allowUpstreamSelfUpdate": false
  },
  "androidFullUpdate": {
    "source": "official-upstream-stable",
    "automaticCheckHours": 24,
    "useExistingBootstrap": true,
    "verifySignedChecksum": true,
    "atomicActivation": true,
    "runningJobKeepsVersion": true,
    "retainPrevious": true,
    "dependsOnSgtCatalog": false
  }
}
