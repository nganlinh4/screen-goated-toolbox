{
  "version": 18,
  "id_rule": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-(?:text|vision|audio|search)$",
    "forbidden_lifecycle_segments": [
      "preview",
      "latest",
      "experimental",
      "stable",
      "deprecated",
      "retired"
    ],
    "provider_prefixes": {
      "google": "google-",
      "google-gtx": "google-",
      "gemini-live": "google-",
      "groq": "groq-",
      "openrouter": "openrouter-",
      "nvidia": "nvidia-",
      "taalas": "taalas-",
      "qrserver": "qrserver-",
      "parakeet": "local-",
      "qwen3": "local-"
    }
  },
  "localized_name_prefixes": {
    "google": "GG ",
    "google-gtx": "GG ",
    "gemini-live": "GG ",
    "groq": "G ",
    "openrouter": "O ",
    "nvidia": "N ",
    "taalas": "T ",
    "qrserver": "QR ",
    "parakeet": "L ",
    "qwen3": "L "
  },
  "localized_name_cases": [
    {
      "model_id": "google-gemini-2-5-live-transcribe-audio",
      "vi": "GG Live cũ (Chép)",
      "ko": "GG 구형 Live (받아쓰기)",
      "en": "GG Older Live (Transcribe)"
    },
    {
      "model_id": "google-gemini-2-5-live-custom-audio",
      "vi": "GG Live cũ",
      "ko": "GG 구형 Live",
      "en": "GG Older Live"
    },
    {
      "model_id": "google-gemini-3-1-live-transcribe-audio",
      "vi": "GG Live (Chép)",
      "ko": "GG Live (받아쓰기)",
      "en": "GG Live (Transcribe)"
    },
    {
      "model_id": "google-gemini-3-1-live-custom-audio",
      "vi": "GG Live",
      "ko": "GG Live",
      "en": "GG Live"
    },
    {
      "model_id": "google-gemini-3-5-transcribe-live-audio",
      "vi": "GG Live mới",
      "ko": "GG 신규 Live",
      "en": "GG New Live"
    },
    {
      "model_id": "google-gemini-3-5-transcribe-audio",
      "vi": "GG Trung thực",
      "ko": "GG 충실",
      "en": "GG Faithful"
    },
    {
      "model_id": "groq-gpt-oss-20b-text",
      "vi": "G Gọn",
      "ko": "G 간결",
      "en": "G Compact"
    },
    {
      "model_id": "groq-qwen-3-8-27b-text",
      "vi": "G Tối ưu",
      "ko": "G 최적",
      "en": "G Optimized"
    }
  ],
  "performance": {
    "intelligence_tier_min": 1,
    "intelligence_tier_max": 6,
    "intelligence_stat_icons": [
      "stat_minus_3",
      "stat_minus_2",
      "stat_minus_1",
      "stat_1",
      "stat_2",
      "stat_3"
    ],
    "unknown_label": "—",
    "latency_format_cases": [
      {
        "milliseconds": 800,
        "label": "0.8s"
      },
      {
        "milliseconds": 1050,
        "label": "1.1s"
      },
      {
        "milliseconds": 20000,
        "label": "20s"
      }
    ]
  },
  "display_sort": [
    "typical_latency_ms",
    "id"
  ],
  "adaptive_priority": {
    "default_enabled": true,
    "per_chain_toggle": true,
    "live_rows_editable": true,
    "live_row_reorder_creates_pin": true,
    "live_row_delete_creates_exclusion": true,
    "non_live_edits_preserve_enabled": true,
    "row_overrides_preserve_enabled": true,
    "manual_edit_without_live_rows_disables_live": true,
    "dedicated_capabilities_excluded_from_generic_chains": true,
    "reset_clears_row_overrides": true,
    "refresh_reorders_only_while_enabled": true,
    "maximum_offers_per_chain": 5,
    "minimum_unpinned_live_position": 3,
    "live_rows_show_ranking_latency": true,
    "publisher_owns_offer_admission": true,
    "feed_absence_removes_nvidia_from_live_routing": true,
    "signed_feed_projects_all_nvidia_selectors": true,
    "feed_endpoint_identity_includes_modality": true,
    "reviewed_withdrawal_remains_quality_veto": true,
    "quality_latency_multiplier_per_tier": 1.5,
    "windows_live_feed": true,
    "android_live_feed": true,
    "signed_feed_schema": 3,
    "availability_gate_version": 1,
    "verified_cache_replace": "atomic_with_same_directory_fallback"
  },
  "selector_availability": {
    "shared_provider_predicate": true,
    "node_editor_observes_live_feed_revision": true,
    "nvidia_respects_provider_switch": true
  },
  "priority_chain_size": {
    "user_limit": null,
    "prepared_image_default_target": 10,
    "prepared_text_default_target": 12
  },
  "default_head_adoption": {
    "speed_wins_after_quality_floor": true,
    "uses_full_result_latency": true,
    "successor_requires_clean_restatement_evidence_for_first_place": true,
    "provisional_successor_position": 2
  },
  "priority_numbering": {
    "chosen_model": 0,
    "first_editable_model": 1,
    "automatic_fallback": "next"
  },
  "performance_columns": {
    "intelligence_width": 15,
    "inter_column_gap": 2,
    "latency_width": 32,
    "latency_alignment": "end",
    "numeric_style": "tabular"
  },
  "performance_prefix_visibility": {
    "expanded_model_options": true,
    "priority_chain_rows": true,
    "general_collapsed_selectors": false
  },
  "search_marker": {
    "source_field": "search_tool_enabled_by_default",
    "requires_provider_capability": true,
    "capability_alone_never_draws_marker": true,
    "built_in_model_ids": [
      "groq-compound-mini-search",
      "groq-compound-search"
    ]
  },
  "row_order": [
    "intelligence_stat",
    "latency",
    "provider_icon",
    "localized_name",
    "details"
  ],
  "surfaces": [
    "windows-node-model-menu",
    "windows-priority-menu",
    "windows-locked-catalog",
    "windows-usage-list",
    "android-node-model-menu",
    "android-priority-menu",
    "android-locked-catalog",
    "android-usage-list",
    "screen-recorder-translation-menu"
  ]
}
