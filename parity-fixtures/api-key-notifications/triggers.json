{
  "version": 2,
  "cases": [
    {
      "name": "preset_result_missing_key",
      "raw_error": "NO_API_KEY:gemini",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "preset_input_voice_missing_key",
      "raw_error": "NO_API_KEY:google",
      "surface": "preset_input_voice",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "read_aloud_missing_key",
      "raw_error": "NO_API_KEY:gemini",
      "surface": "read_aloud_tts",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "translation_gummy_missing_key",
      "raw_error": "Add your Gemini API key before starting Translation Gummy.",
      "surface": "translation_gummy_start",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "Add your Gemini API key before starting Translation Gummy."
    },
    {
      "name": "help_assistant_missing_key",
      "raw_error": "NO_API_KEY:gemini",
      "surface": "help_assistant_overlay",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "live_translate_missing_key",
      "raw_error": "NO_API_KEY:google",
      "surface": "live_translate_start",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "invalid_openrouter_key",
      "raw_error": "INVALID_API_KEY:openrouter",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "OpenRouter",
      "expected_en": "Invalid OpenRouter API key!"
    },
    {
      "name": "credential_provider_comes_from_marker_not_diagnostic_text",
      "raw_error": "NO_API_KEY:gemini while contacting openrouter",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "Gemini",
      "expected_en": "You haven't entered a Gemini API key!"
    },
    {
      "name": "unknown_provider_identity_is_preserved",
      "raw_error": "INVALID_API_KEY:future-provider while contacting groq",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "future-provider",
      "expected_en": "Invalid future-provider API key!"
    },
    {
      "name": "missing_key_without_provider",
      "raw_error": "NO_API_KEY",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "API",
      "expected_en": "You haven't entered an API key!"
    },
    {
      "name": "invalid_key_without_provider",
      "raw_error": "INVALID_API_KEY",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "API",
      "expected_en": "Invalid API key!"
    },
    {
      "name": "invalid_nvidia_key",
      "raw_error": "INVALID_API_KEY:nvidia",
      "surface": "preset_result_overlay",
      "expected_notice": true,
      "expected_provider": "NVIDIA",
      "expected_en": "Invalid NVIDIA API key!"
    }
  ]
}
