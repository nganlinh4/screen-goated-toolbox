{
  "version": 6,
  "cases": [
    {
      "name": "source_index_semantic_retrieval",
      "schema_version": 2,
      "format": "jsonl-gzip",
      "embedding_dimensions": 768,
      "query_prefix": "task: question answering | query: ",
      "top_k": 6,
      "filter_current_platform": true,
      "keyword_fallback": true
    },
    {
      "name": "help_index_context",
      "persistent_verified_cache": true,
      "filter_current_platform": true,
      "top_k": 20,
      "empty_terms_use_first_chunks": true,
      "score_inputs": [
        "path",
        "text"
      ],
      "path_match_boost": 3.0
    },
    {
      "name": "search_ranking_uses_non_overlapping_matches",
      "question": "aa",
      "chunks": [
        {
          "id": "overlap-heavy",
          "path": "docs/one.txt",
          "text": "aaaaa"
        },
        {
          "id": "three-clear-matches",
          "path": "docs/two.txt",
          "text": "aa aa aa"
        }
      ],
      "expected_top_ids": [
        "three-clear-matches",
        "overlap-heavy"
      ]
    },
    {
      "name": "search_terms_keep_hangul_letters",
      "question": "버블 설정은 어디에 있나요?",
      "chunks": [
        {
          "id": "no-term-match",
          "path": "docs/other.txt",
          "text": "unrelated"
        },
        {
          "id": "hangul-match",
          "path": "docs/bubble.txt",
          "text": "버블 설정 화면에서 크기를 바꿉니다"
        }
      ],
      "expected_top_ids": [
        "hangul-match"
      ]
    },
    {
      "name": "search_terms_keep_accented_letters",
      "question": "Làm sao đổi giọng đọc?",
      "chunks": [
        {
          "id": "split-fragment-match",
          "path": "docs/b.txt",
          "text": "sao sao sao gi ng"
        },
        {
          "id": "accented-match",
          "path": "docs/a.txt",
          "text": "Đổi giọng đọc trong cài đặt TTS"
        }
      ],
      "expected_top_ids": [
        "accented-match",
        "split-fragment-match"
      ]
    },
    {
      "name": "android_settings_entry_surface",
      "section": "SETTINGS",
      "entry_surface": "material3_dialog_or_sheet",
      "answer_surface": "floating_overlay_result",
      "platform_prompt_scope": "android",
      "question_surface_differs_from_windows": true
    },
    {
      "name": "android_overlay_permission_recovery",
      "missing_overlay_permission": "launch_system_overlay_settings",
      "pending_question_preserved": true,
      "retry_overlay_after_permission_granted": true,
      "fallback_answer_surface": "none"
    },
    {
      "name": "model_chain",
      "primary": "google-gemini-3-5-flash-lite-vision",
      "fallback": "google-gemini-3-5-flash-vision",
      "max_output_tokens": 4096,
      "temperature": 0.7,
      "thinking_config": {
        "google-gemini-3-5-flash-lite-vision": {
          "thinkingLevel": "LOW"
        },
        "google-gemini-3-5-flash-vision": {
          "thinkingLevel": "LOW"
        }
      }
    },
    {
      "name": "long_lived_request_behavior",
      "use_dedicated_help_assistant_clients": true,
      "allow_large_help_index_fetches": false,
      "allow_long_generation_latency": true
    },
    {
      "name": "prompt_contract",
      "question_language_answer": true,
      "markdown_output": true,
      "forbid_made_up_information": true,
      "forbid_source_code_framing": true,
      "require_locale_correct_ui_terms": true
    }
  ]
}
