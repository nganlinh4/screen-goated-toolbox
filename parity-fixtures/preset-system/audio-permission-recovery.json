    {"entry": "owner_stopped", "pending": "matching_capture", "effect": "none"},
    {"entry": "input_window_replaced", "pending": "matching_capture", "effect": "none"},
    {"entry": "input_window_unchanged", "pending": "matching_capture", "effect": "resume_dictation"},
    {"entry": "stop_before_delivery", "pending": "matching_capture", "effect": "none"},
    {"entry": "stop_requested_before_destroy", "pending": "matching_capture", "effect": "none"}
  ]
