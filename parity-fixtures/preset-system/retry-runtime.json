{
  "provider_settings": {
    "use_groq": true,
    "use_gemini": true,
    "use_openrouter": true,
    "use_nvidia": true,
    "use_ollama": false
  },
  "provider_credentials": {
    "encrypted_at_rest": true,
    "required_runtime_keys": [
      "gemini",
      "groq",
      "openrouter",
      "nvidia"
    ]
  },
  "retry_circuit": {
    "initial_failure_cases": [
      {
        "error": "EMPTY_MODEL_RESPONSE:No text returned",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "Provider API HTTP 503: service unavailable",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "Provider API HTTP 502: upstream failure",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "request timed out",
        "reason": "MODEL_FIRST_TIMEOUT_COOLDOWN"
      },
      {
        "error": "PROVIDER_RESPONSE_INVALID:Provider response error 500: capacity exhausted",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "PROVIDER_RESPONSE_INVALID:Malformed provider stream event",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "PROVIDER_RESPONSE_INVALID:Provider returned no output content",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "PROVIDER_RESPONSE_INVALID:Provider stream ended before completion",
        "reason": "MODEL_INVALID_RESPONSE_COOLDOWN"
      },
      {
        "error": "PROVIDER_RESPONSE_INVALID:Provider completion token limit reached",
        "reason": ""
      },
      {
        "error": "Cancelled",
        "reason": ""
      },
      {
        "error": "Failed to decode input image",
        "reason": ""
      },
      {
        "error": "PROVIDER_REQUEST_LIMIT:Groq API HTTP 429: request exceeds token allowance",
        "reason": ""
      }
    ],
    "rate_limit_default_seconds": 300,
    "reported_rate_limit_min_seconds": 5,
    "reported_rate_limit_max_seconds": 21600,
    "first_timeout_open_seconds": 15,
    "invalid_response_open_seconds": 15,
    "consecutive_timeout_cooldowns_seconds": [
      15,
      15,
      60,
      60
    ],
    "output_limit_opens_circuit": false,
    "chain_owned_provider_retries": 0,
    "timeout_open_seconds": 60,
    "unavailable_open_seconds": 21600,
    "billing_open_seconds": 21600,
    "half_open_probe_limit": 1,
    "success_clears_failures": true,
    "abandoned_probe_releases_claim": true,
    "known_token_budget_preflight": true,
    "provider_error_body_preserved_all_modalities": true,
    "audio_whole_call_timeout": null
  },
  "interactive_deadlines": {
    "benchmark_latency_role": "ranking_presentation_and_deadline_baseline",
    "presentation_transport_streaming_separate": true,
    "default_latency_ms": 3000,
    "request_bytes_per_allowance_second": 262144,
    "maximum_request_allowance_ms": 3000,
    "connect_timeout_ms": 5000,
    "send_base_timeout_ms": 2000,
    "maximum_send_timeout_ms": 10000,
    "response_start_latency_multiplier": 3,
    "minimum_response_start_timeout_ms": 2500,
    "maximum_response_start_timeout_ms": 15000,
    "first_token_latency_multiplier": 2,
    "minimum_first_token_timeout_ms": 3000,
    "maximum_first_token_timeout_ms": 8000,
    "streaming_deadline_ends_on": "first_nonempty_output_token",
    "headers_keepalives_and_thinking_satisfy_deadline": false,
    "streaming_post_first_token_timeout_ms": null,
    "attempt_latency_multiplier": 4,
    "minimum_attempt_timeout_ms": 5000,
    "maximum_attempt_timeout_ms": 30000,
    "dispatch_attempt_cap": null,
    "chain_budget_mode": "fresh_initial_budget_per_dispatched_attempt",
    "chain_traversal": "until_success_cancellation_terminal_error_or_exhaustion",
    "provider_blocking_transport_phases": [
      "dns",
      "tls",
      "connect",
      "send"
    ],
    "model_scoped_timeout_phases": [
      "response_start",
      "first_token",
      "attempt"
    ]
  },
  "recommended_model_defaults": {
    "generic_image": "groq-qwen-3-8-27b-vision",
    "image_ask": "groq-qwen-3-8-27b-vision",
    "generic_text": "groq-qwen-3-8-27b-text",
    "text_arena_fast": "groq-gpt-oss-20b-text",
    "text_game": "google-gemini-3-5-flash-lite-text",
    "search": "groq-compound-mini-search",
    "audio_transcribe": "groq-whisper-large-v3-audio",
    "audio_continuous": "google-gemini-3-5-transcribe-live-audio",
    "audio_direct_translate": "google-gemini-3-5-flash-lite-audio",
    "audio_device_continuous": "google-gemini-3-5-transcribe-live-audio"
  },
  "recommended_settings_update": {
    "apply_changed_builtin_model_slots": true,
    "restore_priority_chains": true,
    "enable_recommended_providers": true,
    "disable_other_providers": false,
    "skip_preserves_current_settings": true
  },
  "model_priority_chains": {
    "image_to_text": [
      "groq-qwen-3-8-27b-vision",
      "google-gemini-3-5-flash-lite-vision",
      "google-gemini-3-1-flash-lite-vision",
      "google-gemini-3-flash-vision",
      "google-gemini-3-5-flash-vision",
      "google-gemma-4-26b-a4b-vision",
      "openrouter-dots-3-note-vision",
      "google-gemini-robotics-er-2-vision",
      "google-gemini-3-6-flash-vision",
      "google-gemini-3-8-flash-vision"
    ],
    "text_to_text": [
      "groq-qwen-3-8-27b-text",
      "groq-gpt-oss-20b-text",
      "groq-gpt-oss-120b-text",
      "google-gemini-3-1-flash-lite-text",
      "google-gemini-robotics-er-2-text",
      "google-gemini-3-flash-text",
      "google-gemma-4-26b-a4b-text",
      "google-gemini-3-5-flash-lite-text",
      "google-gemini-3-5-flash-text",
      "google-gemini-3-8-live-text",
      "google-gemini-3-8-flash-text",
      "openrouter-nemotron-3-super-120b-text"
    ]
  }
}
