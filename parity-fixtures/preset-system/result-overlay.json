      { "name": "doctype_prefix_only", "input": "<!doctypex html><html>hello</html>", "raw": false },
      { "name": "doctype_vertical_tab", "input": "<!doctype\u000bhtml><html>hello</html>", "raw": false },
      { "name": "html_vertical_tab", "input": "<html\u000b><body>hello</body></html>", "raw": false },
      { "name": "other_fence", "input": "```text\n<html><body>hello</body></html>\n```", "raw": false },
