{
  "surface": "preset_result_overlay",
  "render_mode": "markdown_only",
  "window_creation": "precreate_before_result_text",
  "opacity": {
    "default_percent": 90,
    "minimum_percent": 10,
    "maximum_percent": 100,
    "missing_value_uses_default": true,
    "explicit_saved_value_is_preserved": true
  },
  "interactive_html": {
    "preset_id": "preset_make_game",
    "input_policy": "game_appropriate_keyboard_pointer_touch_or_combination",
    "keyboard_activation": "click_or_tap_result_focuses_embedded_document",
    "visible_control_instructions": true,
    "mouse_only_constraint": false
  },
  "windows": [
    {
      "block_idx": 1,
      "show_overlay": true,
      "render_mode": "markdown_stream",
      "expected_window": true
    },
    {
      "block_idx": 2,
      "show_overlay": false,
      "render_mode": "markdown_stream",
      "expected_window": false
    },
    {
      "block_idx": 3,
      "show_overlay": true,
      "render_mode": "markdown",
      "expected_window": true
    }
  ],
  "canvas": {
    "reveal_model": "tap_and_linger",
    "model_badge": {
      "identity": "actual_successful_retry_endpoint",
      "format": "provider_display_name_middle_dot_full_api_model",
      "empty_for_non_model_results": true
    },
    "refine": {
      "first_choice": "actual_successful_text_endpoint",
      "fallback": "adaptive_text_to_text_chain_with_circuit_policy",
      "model_badge": "actual_successful_refine_endpoint"
    },
    "linger_ms": 2000,
    "unsupported_actions": [
      "markdown_toggle",
      "broom_group_all"
    ]
  },
  "markdown_view": {
    "font_family": "Google Sans Flex",
    "theme_source": "windows_markdown_css_rs",
    "fit_script_source": "windows_streaming_fit_impl_rs",
    "streaming_update_source": "windows_markdown_streaming_rs",
    "gridjs_enabled_for_tables": true,
    "dom_contract": "body_level_markdown_content",
    "render_mode": "markdown_plus_raw_html",
    "raw_html_supported": true,
    "raw_html_normalization": "complete_document_or_single_outer_html_fence",
    "raw_html_document_authority": "loaded_document_is_never_replaced_by_generic_body_inner_html",
    "raw_html_style_authority": "authored_document_owns_typography_layout_animation_and_input_css",
    "raw_html_script_lifecycle": "inline_scripts_execute_once_during_document_load_and_keep_live_state",
    "theme_sync_scope": "all_preset_overlays",
    "touch_scroll_model": "two_finger_bidirectional_native_scroll",
    "raw_html_host_contract": "page_load_reinjected_overlay_shell",
    "input_adapter_media_contract": {
      "canonical_source": "windows_chain_templates_rs",
      "runtime_owner": "result_window_runtime",
      "preserve_markers": [
        "data-sgt-input-adapter-media",
        "audio-player"
      ],
      "body_chrome_policy": "disable_generic_markdown_body_chrome_for_media_docs"
    },
    "navigation_model": "native_history_plus_restore_original_surface",
    "navigation_internal_entry_policy": "restore_original_surface_and_clear_history",
    "failed_external_navigation_policy": "restore_original_surface"
  }
}
