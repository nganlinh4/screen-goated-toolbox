      { "name": "complete_table_with_select", "input": "<html><body><table><tr><td><select><option>ok</option></select></td></tr></table></body></html>", "raw": true },
      { "name": "complete_nested_frameset", "input": "<html><frameset><frameset><frame></frameset></frameset></html>", "raw": true },
