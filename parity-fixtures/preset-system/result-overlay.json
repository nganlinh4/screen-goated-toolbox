      { "name": "spaced_root_close", "input": "<html><body>ok</body></html  >", "raw": true },
      { "name": "prose_after_root", "input": "<html><body>ok</body></html> Explanation.", "raw": false },
      { "name": "implicit_root_close", "input": "<!doctype html><html><body>ok", "raw": false }
