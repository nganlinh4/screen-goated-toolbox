      { "name": "foreign_prior_child_self_closing_title", "input": "<html><svg><circle/><title/></svg></html>", "raw": false },
      { "name": "svg_unquoted_slash_is_value", "input": "<html><body><svg x=foo/></html>", "raw": false },
      { "name": "math_unquoted_slash_is_value", "input": "<html><body><math x=foo/></html>", "raw": false },
      { "name": "svg_explicit_self_close_after_unquoted", "input": "<html><body><svg x=foo /></body></html>", "raw": true },
      { "name": "math_explicit_self_close_after_quoted", "input": "<html><body><math x=\"foo/\"/></body></html>", "raw": true },
      { "name": "math_title_ambiguous_markup", "input": "<html><math><title><template></title></math></html>", "raw": false },
      { "name": "html_cdata_hides_root", "input": "<html><body><![CDATA[x> </html> <script>window.marker=1</script> ]]> </html>", "raw": false },
      { "name": "html_cdata_hides_template", "input": "<html><body><![CDATA[x><template>]]></html>", "raw": false },
      { "name": "svg_integration_cdata_hides_template", "input": "<html><svg><foreignObject><![CDATA[x><template>]]></foreignObject></svg></html>", "raw": false },
      { "name": "svg_title_cdata_hides_template", "input": "<html><svg><title><![CDATA[x><template>]]></title></svg></html>", "raw": false },
      { "name": "foreign_cdata_root_text", "input": "<html><body><svg><![CDATA[</html>]]></svg></body></html>", "raw": false },
      { "name": "document_comments", "input": "<!-- before --><!doctype html><!-- middle --><html><body>ok</body></html><!-- after -->", "raw": true },
      { "name": "malformed_comment_after_root", "input": "<html><body>ok</body></html><!--><script>run()</script>-->", "raw": false },
      { "name": "malformed_comment_in_root", "input": "<html><!-- --!><script>run()</script>--></html>", "raw": false },
      { "name": "script_contains_root_marker", "input": "<html><script>const value = '</html>';</script></html>", "raw": true },
      { "name": "open_root_with_quoted_gt", "input": "<html data-value=\"a>b\"><body>ok</body></html>", "raw": true },
      { "name": "multiple_quoted_attributes", "input": "<html lang=\"en\" data-note='ok'><body>ok</body></html>", "raw": true },
