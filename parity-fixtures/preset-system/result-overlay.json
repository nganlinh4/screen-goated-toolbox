{
  "plain_text": {"escapesHtml": true, "preservesSource": true, "rawHtmlToggle": false},
  "surface": "preset_result_overlay",
  "render_mode": "markdown_only",
  "window_creation": "precreate_before_result_text",
  "opacity": {
    "default_percent": 90,
    "minimum_percent": 10,
    "maximum_percent": 100,
    "missing_value_uses_default": true,
    "explicit_saved_value_is_preserved": true
  },
  "interactive_html": {
    "preset_id": "preset_make_game",
    "input_policy": "game_appropriate_keyboard_pointer_touch_or_combination",
    "keyboard_activation": "click_or_tap_result_focuses_embedded_document",
    "visible_control_instructions": true,
    "mouse_only_constraint": false
  },
  "windows": [
    {
      "block_idx": 1,
      "show_overlay": true,
      "render_mode": "markdown_stream",
      "expected_window": true
    },
    {
      "block_idx": 2,
      "show_overlay": false,
      "render_mode": "markdown_stream",
      "expected_window": false
    },
    {
      "block_idx": 3,
      "show_overlay": true,
      "render_mode": "markdown",
      "expected_window": true
    }
  ],
  "canvas": {
    "reveal_model": "tap_and_linger",
    "model_badge": {
      "identity": "actual_successful_retry_endpoint",
      "format": "provider_display_name_middle_dot_full_api_model",
      "empty_for_non_model_results": true
    },
    "refine": {
      "first_choice": "actual_successful_text_endpoint",
      "fallback": "adaptive_text_to_text_chain_with_circuit_policy",
      "model_badge": "actual_successful_refine_endpoint"
    },
    "linger_ms": 2000,
    "unsupported_actions": [
      "broom_group_all"
    ]
  },
  "markdown_view": {
    "toggle": "visible_touch_control_with_pressed_state",
    "plain_text": "literal_source_preserved_across_streaming_and_theme",
    "raw_html_toggle": "hidden_and_not_clickable",
    "font_family": "Google Sans Flex",
    "theme_source": "windows_markdown_css_rs",
    "fit_script_source": "windows_streaming_fit_impl_rs",
    "streaming_update_source": "windows_markdown_streaming_rs",
    "gridjs_enabled_for_tables": true,
    "gridjs_assets": "shared_pinned_windows_bundle",
    "markdown_html_policy": "windows_result_compositor_allowlist",
    "android_external_intent_policy": "user_gesture_required",
    "android_untrusted_document_policy": "separate_raw_and_intercepted_navigation_webview_other_external_documents_origin_denied",
    "android_trusted_result_bridge": "origin_bound_main_frame_only",
    "android_native_tap_controls": "reveal_on_every_tap_including_active_result",
    "dom_contract": "body_level_markdown_content",
    "render_mode": "markdown_plus_raw_html",
    "raw_html_supported": true,
    "raw_html_normalization": "complete_document_or_single_outer_html_fence",
    "raw_html_classification_cases": [
      { "name": "document", "input": "<!doctype html><html><body>hello</body></html>", "raw": true },
      { "name": "uppercase_with_bom", "input": "\ufeff  <HTML lang=\"en\"><body>hello</body></HTML>", "raw": true },
      { "name": "unicode_next_line_around_document", "input": "\u0085<html>ok</html>\u0085", "raw": true },
      { "name": "non_whitespace_control_before_document", "input": "\u001c<html>ok</html>", "raw": false },
      { "name": "single_html_fence", "input": "```html\n<html><body>hello</body></html>\n```", "raw": true },
      { "name": "single_unlabelled_fence", "input": "```\n<html><body>hello</body></html>\n```", "raw": true },
      { "name": "single_carriage_return_fence", "input": "```html\r<html><body>hello</body></html>\r```", "raw": true },
      { "name": "single_crlf_fence", "input": "```html\r\n<html><body>hello</body></html>\r\n```", "raw": true },
      { "name": "earlier_carriage_return_fence", "input": "```html\r<html><script>\r```\rlet x=1;\r</script></html>\r```", "raw": false },
      { "name": "longer_closing_fence", "input": "```html\n<html><body>hello</body></html>\n````", "raw": true },
      { "name": "indented_marker_in_script", "input": "```html\n<html><script>\nconst text = `\n    ```\n`;\n</script></html>\n```", "raw": true },
      { "name": "earlier_closing_fence", "input": "```html\n<html><body>hello</body></html>\n```\nExplanation.\n```", "raw": false },
      { "name": "earlier_fence_before_lone_cr", "input": "```html\n<html><script>\n```\rconst x=1;\n</script></html>\n```", "raw": false },
      { "name": "inline_script", "input": "Use `<script>` to add behavior.", "raw": false },
      { "name": "inline_style", "input": "Use `<style>` to add styles.", "raw": false },
      { "name": "embedded_document", "input": "Example: <html><body>hello</body></html> afterword", "raw": false },
      { "name": "fenced_example_with_prose", "input": "Example:\n\n```html\n<html><body>hello</body></html>\n```\n\nExplanation.", "raw": false },
      { "name": "fragment", "input": "<div>hello<script>run()</script></div>", "raw": false },
