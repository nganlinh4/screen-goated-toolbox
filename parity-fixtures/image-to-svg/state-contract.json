{
  "schemaVersion": 6,
  "tool": "image-to-svg",
  "states": [
    "draft",
    "queued",
    "preparing",
    "generating",
    "finalizing",
    "done",
    "failed",
    "cancelled"
  ],
  "models": {
    "simple": {
      "selectable": true
    },
    "detail": {
      "selectable": true
    }
  },
  "limits": {
    "maximumParallelJobs": 2,
    "maximumConcurrentPreparations": 1,
    "minimumPreparationIntervalSeconds": 60,
    "preparedWorkspaces": 2
  },
  "input": {
    "minimumImagesPerJob": 1,
    "maximumImagesPerJob": 1,
    "multiplePickerImagesCreateIndependentJobs": true
  },
  "submission": {
    "primaryActionScope": "selected_session",
    "submitsOtherSessions": false
  },
  "viewer": {
    "preserveIntrinsicRatio": true,
    "allPathsRendered": true,
    "animateAllPaths": false,
    "maximumAnimatedPaths": 120,
    "adaptiveOverlappingAnimation": true,
    "editableShapes": ["path", "rect", "circle", "ellipse", "polygon", "polyline", "line"]
  },
  "previewMemory": {
    "webviewRetainsOriginalImageBytes": false,
    "thumbnailMaximumEdgePixels": 128,
    "stageMaximumEdgePixels": 1600,
    "hydrationBlocksSessionActions": false,
    "decodeBlocksWebviewThread": false,
    "offscreenPreviewsHydrate": false,
    "selectedPreviewHasPriority": true,
    "backgroundHydrationYieldsToInteraction": true
  },
  "presentation": {
    "iconFamily": "Material Symbols Rounded",
    "iconFill": 1,
    "sharedIconCatalog": true,
    "unchangedPollPreservesQueueDom": true,
    "hoveredSelectionTargetSurvivesPolling": true,
    "pointerSequenceSurvivesPolling": true,
    "queueOwnsOverflow": true,
    "primaryActionRemainsReachable": true
  },
  "history": {
    "requireExistingOutput": true,
    "renameMutatesOutput": true,
    "deleteMutatesOutput": true
  },
  "androidSurface": {
    "shell": "native_compose_m3e",
    "resultRenderer": "sandboxed_svg_document",
    "progressPreview": "depth_anything_3_six_bins",
    "previewInputSide": 518,
    "previewBlocksGeneration": false,
    "previewSetupVisible": false,
    "preparationProgressMaximumPercent": 18,
    "diagnostics": "bounded_privacy_safe_journal",
    "backgroundAutomationVisible": false
  },
  "hostLifecycle": {
    "cancelWinsOverLateSuccess": true,
    "closeCancelsToolJobs": true,
    "closeTerminatesTrackedProcessTrees": true,
    "closeDestroysWebSurface": true,
    "sharedPreparationSurvivesMiniAppClose": true
  },
  "distribution": {
    "fullSupported": true,
    "playSupported": true,
    "downloadExecutableCode": false
  }
}
