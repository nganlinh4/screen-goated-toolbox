{
  "schemaVersion": 1,
  "feature": "phone-control-exact-resource-boundary",
  "invariants": {
    "activation": "failed_dedicated_file_transaction_with_absolute_file_target",
    "reset": "new_or_retired_turn",
    "successfulExactTransactionClearsOnlyItsResource": true,
    "directoryEntryAndFileObjectAreDistinctIdentities": true,
    "hardLinkAliasesShareFailureEvidence": true,
    "atomicReplacementClearsOnlyTheSelectedEntry": true,
    "caseDistinctNamesAreNeverMergedByTextFolding": true,
    "caseAliasMatchingRequiresProvenNativeDirectoryPolicy": true,
    "caseAliasRequiresMatchingNativeOpenedEntry": true,
    "creditRequiresCurrentReceiptDigestWhileReadLeaseIsHeld": true,
    "inPlaceReceiptCannotCreditReplacement": true,
    "metadataOwnershipReleasedAtTurnRetirement": true,
    "sameTurnRebindDoesNotClearEvidence": true,
    "staleJobCannotReopenRetiredBoundary": true,
    "requestRevisionInvalidatesInFlightAssessment": true,
    "platformReadIsolationLimitsRemainExplicit": true,
    "sessionAuthorityIndependentOfConversationPersistence": true,
    "identityCapturedBeforeDispatch": true,
    "unknownIdentityCannotClearEvidence": true,
    "argumentTextCannotSkipAssessment": true,
    "selectedValidatedDeclarationRequired": true,
    "freshAssessmentForEachAlternateEffect": true,
    "unknownOrDeniedScopeDispatchesNoEffect": true,
    "cancellationBeforeDispatchDispatchesNoEffect": true,
    "scopeApprovalDoesNotVerifyTheEffect": true,
    "fullCatalogRemainsAvailable": true,
    "artifactReplacementCannotBypassTextTransaction": true
  },
  "cases": [
    {"id":"relative-process-path", "tool":"run_command", "arguments":{"program":"resource-tool","args":["result.csv"],"cwd":"<resource-parent>"}, "needsAssessment":true},
    {"id":"quoted-resource-read", "tool":"run_command", "arguments":{"command":"read-resource '<protected-path>'"}, "needsAssessment":true},
    {"id":"opaque-alias", "tool":"run_command", "arguments":{"command":"invoke-resource $env:TARGET"}, "needsAssessment":true},
    {"id":"indexed-ui-effect", "tool":"act", "arguments":{"id":7,"verb":"activate"}, "needsAssessment":true},
    {"id":"browser-expression", "tool":"browser_eval", "arguments":{"expression":"performOperation()"}, "needsAssessment":true},
    {"id":"future-capability", "tool":"future_mutation", "arguments":{"opaque":true}, "needsAssessment":true},
    {"id":"focus-action", "tool":"focus_window", "arguments":{"title":"Document"}, "needsAssessment":true},
    {"id":"artifact-replacement", "tool":"save_artifact", "arguments":{"path":"<protected-path>","overwrite":true}, "needsAssessment":true},
    {"id":"dedicated-read", "tool":"read_text_file", "arguments":{"path":"<protected-path>"}, "needsAssessment":false},
    {"id":"observation", "tool":"observe", "arguments":{}, "needsAssessment":false},
    {"id":"dedicated-exact-edit", "tool":"edit_text_file", "arguments":{"path":"<protected-path>"}, "needsAssessment":false},
    {"id":"dedicated-structural-edit", "tool":"edit_text_file_structure", "arguments":{"path":"<protected-path>"}, "needsAssessment":false},
    {"id":"terminal-signal", "tool":"done", "arguments":{}, "needsAssessment":false}
  ]
}
