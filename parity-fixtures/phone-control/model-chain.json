{
  "version": 3,
  "live_session": {
    "api_model": "gemini-3.1-flash-live-preview",
    "thinking_config": {
      "thinkingLevel": "LOW",
      "includeThoughts": true
    },
    "realtime_input_config": {
      "automaticActivityDetection": {
        "startOfSpeechSensitivity": "START_SENSITIVITY_HIGH",
        "endOfSpeechSensitivity": "END_SENSITIVITY_HIGH",
        "prefixPaddingMs": 30,
        "silenceDurationMs": 250
      },
      "activityHandling": "START_OF_ACTIVITY_INTERRUPTS"
    },
    "controller_contract": {
      "evidenceRoutingAddendum": true,
      "communicativeIntentRule": true,
      "languageSpecificRouting": false
    }
  },
  "grounding": {
    "catalog_chain": "computer_control_grounding",
    "models": [
      "google-gemini-3-5-flash-lite-vision",
      "google-gemini-3-1-flash-lite-vision"
    ],
    "environment_override": "CC_VISION_MODEL",
    "override_replaces_default_chain": true,
    "advance_on": [
      "transport_error",
      "empty_response",
      "malformed_structured_response"
    ],
    "terminal_results": [
      "valid_target_not_visible",
      "valid_verification_rejection"
    ],
    "inherits_general_image_chain": false
  }
}
