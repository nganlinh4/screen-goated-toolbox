{
  "version": 5,
  "live_session": {
    "api_model": "gemini-3.1-flash-live-preview",
    "thinking_config": {
      "thinkingLevel": "LOW",
      "includeThoughts": true
    },
    "realtime_input_config": {
      "automaticActivityDetection": {
        "startOfSpeechSensitivity": "START_SENSITIVITY_HIGH",
        "endOfSpeechSensitivity": "END_SENSITIVITY_HIGH",
        "prefixPaddingMs": 30,
        "silenceDurationMs": 250
      },
      "activityHandling": "START_OF_ACTIVITY_INTERRUPTS"
    },
    "controller_contract": {
      "evidenceRoutingAddendum": true,
      "communicativeIntentRule": true,
      "languageSpecificRouting": false
    }
  },
  "grounding": {
    "catalog_chain": "computer_control_grounding",
    "models": [
      "google-gemini-3-5-flash-lite-vision",
      "google-gemini-3-1-flash-lite-vision"
    ],
    "environment_override": "CC_VISION_MODEL",
    "override_replaces_default_chain": true,
    "advance_on": [
      "transport_error",
      "empty_response",
      "malformed_structured_response"
    ],
    "terminal_results": [
      "valid_target_not_visible",
      "valid_verification_rejection"
    ],
    "inherits_general_image_chain": false,
    "response_contract": {
      "coordinate_grid": 1000,
      "maximum_marks": 30,
      "named_point_record": "M|target|x|y|label",
      "open_mark_record": "M|label|x|y",
      "not_visible_records": ["N", "N|target", "N|from", "N|to"],
      "named_not_visible_set": "terminal when every expected identifier appears exactly once and at least one record is N",
      "drag_endpoint_records": [
        "M|from|x|y|label",
        "M|to|x|y|label"
      ],
      "optional_final_delimiter": true,
      "duplicate_or_unknown_ids": "invalid",
      "out_of_range_coordinates": "invalid",
      "surrounding_prose": "invalid"
    },
    "verification_contract": {
      "format": "exact_json_object",
      "required_fields": [
        "matches",
        "confidence",
        "what"
      ],
      "unknown_fields": "invalid",
      "surrounding_prose": "invalid",
      "confidence_range": [
        0,
        100
      ],
      "minimum_acceptance_confidence": 70,
      "valid_rejection": "terminal"
    }
  }
}
