{
  "schemaVersion": 58,
  "tool": "image-to-3d",
  "runtimeDelivery": {
    "authority": "tracked-immutable-contract",
    "sharedAcrossWindowsAndAndroid": true,
    "requiresExactUrlVersionSizeAndSha256": true,
    "missingContractFailsBuild": true,
    "acceptsLocalRuntimeFallback": false,
    "acceptsEnvironmentOverride": false
  },
  "names": {
    "en": "Image to 3D",
    "ko": "이미지를 3D로",
    "vi": "Ảnh sang 3D"
  },
  "states": [
    "idle",
    "runtime_missing",
    "queued",
    "preparing",
    "generating",
    "segmenting",
    "finalizing",
    "done",
    "failed",
    "cancelled"
  ],
  "defaults": {
    "polycount": 5000,
    "autoSegment": false,
    "segmentationMode": "none",
    "generationMode": "quality",
    "topologyMode": "topology_mesh",
    "outputFormat": "glb_plain"
  },
  "limits": {
    "minimumPolycount": 100,
    "maximumPolycount": 20000,
    "maximumParallelJobs": 2,
    "maximumJobRuntimeMs": 7200000,
    "continuationWindowHours": 24,
    "maximumHistoryEntries": 200,
    "maximumResultBytes": 104857600
  },
  "readiness": {
    "immediateReserveCoversParallelLimit": true,
    "acceptedDemandExpandsPreparation": true,
    "expansionIsBounded": true,
    "consumptionStartsBackgroundReplenishment": true,
    "readyWorkDoesNotWaitForReplenishment": true,
    "toolCapacityIsIsolated": true,
    "actionableSurfaceRequired": true,
    "interactiveSemanticSurfaceDoesNotWaitForUnrelatedResources": true,
