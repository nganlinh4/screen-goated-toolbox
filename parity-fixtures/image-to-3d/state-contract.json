{
  "schemaVersion": 11,
  "tool": "image-to-3d",
  "names": {
    "en": "Image to 3D",
    "ko": "이미지를 3D로",
    "vi": "Ảnh sang 3D"
  },
  "states": [
    "idle",
    "runtime_missing",
    "preparing",
    "visualizing",
    "generating",
    "segmenting",
    "finalizing",
    "done",
    "failed",
    "cancelled"
  ],
  "defaults": {
    "polycount": 5000,
    "autoSegment": false,
    "segmentationMode": "none",
    "generationMode": "quality",
    "topologyMode": "topology_mesh",
    "outputFormat": "glb_plain"
  },
  "limits": {
    "minimumPolycount": 100,
    "maximumPolycount": 20000,
    "maximumParallelJobs": 2,
    "maximumConcurrentPreparations": 1,
    "minimumPreparationIntervalSeconds": 60,
    "preparedWorkspaces": 4,
    "continuationWindowHours": 24
  },
  "input": {
    "minimumImagesPerJob": 1,
    "maximumImagesPerJob": 1,
    "multiplePickerImagesCreateIndependentJobs": true
  },
  "submission": {
    "primaryActionScope": "selected_session",
    "submitsOtherSessions": false
  },
  "generationModes": {
    "default": "quality",
    "selectionVisible": true,
    "implementationBrandingVisible": false,
    "cases": [
      {
        "mode": "fast",
        "polycount": 100,
        "autoSegment": false,
        "effectiveAutoSegment": false,
        "showAutoSegment": false,
        "resultSegmented": true,
        "canSegmentAfterGeneration": false
      },
      {
        "mode": "fast",
        "polycount": 15000,
        "autoSegment": true,
        "effectiveAutoSegment": false,
        "showAutoSegment": false,
        "resultSegmented": true,
        "canSegmentAfterGeneration": false
      },
      {
        "mode": "quality",
        "polycount": 501,
        "autoSegment": false,
        "effectiveAutoSegment": false,
        "showAutoSegment": true,
        "resultSegmented": false,
        "canSegmentAfterGeneration": true
      },
      {
        "mode": "quality",
        "polycount": 501,
        "autoSegment": true,
        "effectiveAutoSegment": true,
        "showAutoSegment": true,
        "resultSegmented": true,
        "canSegmentAfterGeneration": false
      },
      {
        "mode": "quality",
        "polycount": 20000,
        "autoSegment": false,
        "effectiveAutoSegment": false,
        "showAutoSegment": true,
        "resultSegmented": false,
        "canSegmentAfterGeneration": true
      }
    ],
    "clampingCases": [
      {
        "mode": "fast",
        "polycount": 20000,
        "normalizedPolycount": 15000,
        "autoSegment": true,
        "effectiveAutoSegment": false,
        "showAutoSegment": false,
        "resultSegmented": true,
        "canSegmentAfterGeneration": false
      },
      {
        "mode": "quality",
        "polycount": 100,
        "normalizedPolycount": 500,
        "autoSegment": false,
        "effectiveAutoSegment": false,
        "showAutoSegment": true,
        "resultSegmented": false,
        "canSegmentAfterGeneration": true
      }
    ]
  },
  "recovery": {
    "intentRecordedBeforeSubmit": true,
    "jobIdentityUsesSourceContent": true,
    "jobIdentityIgnoresSourcePathAndTimestamps": true,
    "jobIdentityIncludesProductSettings": true,
    "matchingJobSerializedAcrossWorkers": true,
    "acceptedJobResumedWithoutResubmit": true,
    "unknownSubmissionFailsClosed": true,
    "artifactCommittedBeforeHostSuccess": true,
    "recoveryRetentionHours": 168
  },
  "segmentation": {
    "selection": "detailed_15_plus",
    "generationPrerequisite": {
      "unsegmentedResult": "validated_artifact",
      "automaticSeparation": "validated_artifact_and_terminal_success",
      "continuation": "validated_artifact_and_terminal_success"
    },
    "allowContinuationAfterGeneration": true,
    "continuationWindowHours": 24,
    "newGenerationMayInvalidatePriorContinuation": true,
    "fastResultIsSegmented": true,
    "requireRenderableNormals": true,
    "expandDisconnectedComponentsForSingleMesh": true,
    "preserveExistingPartNodes": true,
    "windowsViewerRepairsLegacySegmentedOutputs": true
  },
  "history": {
    "requireExistingOutput": true,
    "renameMutatesOutput": true,
    "deleteMutatesOutput": true,
    "freezeGenerationMode": true,
    "retainCurrentSessionResultUntilHistoryPersists": true,
    "doneStatusTransitionsDirectlyToModel": true,
    "terminalItemCanBeReconfiguredAndRerun": true,
    "rerunPreservesPreviousOutput": true
  },
  "presentation": {
    "showImplementationBranding": false,
    "showImplementationSelection": false,
    "showGenerationModeSelection": true,
    "normalizeImplementationText": true,
    "iconFamily": "Material Symbols Rounded",
    "iconFill": 1,
    "sharedIconCatalog": true,
    "unchangedPollPreservesQueueDom": true,
    "hoveredSelectionTargetSurvivesPolling": true,
    "pointerSequenceSurvivesPolling": true,
    "queueOwnsOverflow": true,
    "primaryActionRemainsReachable": true,
    "previewMemory": {
      "webviewRetainsOriginalImageBytes": false,
      "thumbnailMaximumEdgePixels": 128,
      "stageMaximumEdgePixels": 1600,
      "hydrationBlocksSessionActions": false,
      "decodeBlocksWebviewThread": false,
      "offscreenPreviewsHydrate": false,
      "selectedPreviewHasPriority": true,
      "backgroundHydrationYieldsToInteraction": true
    }
  },
  "androidSurface": {
    "shell": "native_compose_m3e",
    "resultRenderer": "sceneview_filament",
    "progressPreview": "depth_anything_3_relief",
    "previewInputSide": 518,
    "previewBlocksGeneration": false,
    "previewSetupVisible": false,
    "preparationProgressMaximumPercent": 18,
    "diagnostics": "bounded_privacy_safe_journal",
    "backgroundAutomationVisible": false,
    "viewerControls": [
      "orbit",
      "zoom",
      "pan",
      "grid",
      "wireframe",
      "auto_rotate",
      "toon",
      "outline"
    ],
    "wireframeAndOutlineIndependent": true
  },
  "hostLifecycle": {
    "workerLossFailsActiveJobExactlyOnce": true,
    "staleCallbackCannotReleaseNewAssignment": true,
    "cancelWinsOverLateSuccess": true,
    "lateSuccessCannotPublishAfterCancel": true,
    "lateSuccessCannotDeletePreviousOutputAfterCancel": true,
    "closeCancelsToolJobs": true,
    "closeTerminatesTrackedProcessTrees": true,
    "closeDestroysWebSurface": true,
    "sharedPreparationSurvivesMiniAppClose": true
  },
  "timing": {
    "persistMeasuredDurations": true,
    "boundedSamples": true,
    "reportSampleCount": true,
    "fixedEstimateOnlyWhenSampleCountIsZero": true
  },
  "distribution": {
    "hostBehavior": "identical",
    "sameRuntimeBuild": true,
    "sameRuntimeManifestVersionAndFeatures": true,
    "full": {
      "supported": true,
      "runtimeDelivery": "verified_download",
      "downloadExecutableCode": true,
      "integrity": {
        "bundleByteCountPinned": true,
        "bundleSha256Pinned": true,
        "extractedFileByteCountsPinned": true,
        "extractedFileSha256Pinned": true
      }
    },
    "play": {
      "supported": true,
      "runtimeDelivery": "packaged_on_demand",
      "downloadExecutableCode": false,
      "networkExecutableFallback": false,
      "integrity": {
        "playAppSigning": true,
        "packagedArtifactSha256Pinned": true
      }
    }
  }
}
