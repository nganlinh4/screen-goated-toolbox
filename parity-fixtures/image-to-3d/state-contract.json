    "maximumPrimitiveAttributes": 16,
    "maximumMorphAttributes": 8,
    "maximumImages": 256,
    "maximumTextures": 512,
    "maximumSamplers": 128,
    "maximumTextureAxisPixels": 8192,
    "maximumPixelsPerTextureImage": 16777216,
    "maximumDecodedImagePixels": 33554432,
    "maximumReferencedTexturePixels": 33554432,
    "texturePayloadMustDecode": true,
    "materialTextureReferencesValidated": true,
    "materialNumericValuesBounded": true,
    "materialRendererValueTypesValidated": true,
