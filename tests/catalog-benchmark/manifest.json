        "Preserves the time as 9:00 tomorrow morning"
      ]
    },
    {
      "id": "text-02-register",
      "difficulty": 2,
      "source_language": "Vietnamese",
      "target_language": "English",
      "input": "Phiền bạn gửi lại hóa đơn trước cuối ngày hôm nay nhé.",
      "reference": "Could you please resend the invoice by the end of today?",
      "required_terms": [
        "invoice",
        "today"
      ],
      "rubric": [
        "Keeps the polite register",
        "Expresses a deadline no later than the end of today"
      ]
    },
    {
      "id": "text-03-numeric-fidelity",
      "difficulty": 3,
      "source_language": "English",
      "target_language": "Vietnamese",
      "input": "The sensor reported 1.05 °C, not 1.5 °C; the threshold remains at −2 °C.",
      "reference": "Cảm biến ghi nhận 1,05 °C, không phải 1,5 °C; ngưỡng vẫn là −2 °C.",
      "required_terms": [
        "cảm biến",
        "ngưỡng"
      ],
      "required_exact": [
        "°C"
      ],
      "required_exact_any": [
        [
          "1,05",
          "1.05"
        ],
        [
          "1,5",
          "1.5"
        ],
        [
          "−2",
          "-2"
        ]
      ],
      "rubric": [
        "Keeps 1.05 distinct from 1.5",
        "Preserves the negative two-degree threshold",
        "Does not convert or drop the unit"
      ]
    },
    {
      "id": "text-04-ui-format",
      "difficulty": 4,
      "source_language": "Japanese",
      "target_language": "English",
      "input": "注意：更新中は電源を切らないでください。\n完了後、［設定］→［同期］を開きます。",
      "reference": "Caution: Do not turn off the power during the update.\nWhen it is complete, open ［Settings］ → ［Sync］.",
      "required_terms": [
        "update",
        "power",
        "Settings",
        "Sync"
      ],
      "required_exact": [
        "→"
      ],
      "required_exact_any": [
        [
          "［Settings］",
          "[Settings]"
        ],
        [
          "［Sync］",
          "[Sync]"
        ]
      ],
      "expected_line_count": 2,
      "rubric": [
        "Preserves the warning",
        "Preserves the two-line structure",
        "Preserves the menu navigation order and exact bracketed labels"
      ]
    },
    {
      "id": "text-05-idiom",
      "difficulty": 5,
      "source_language": "Korean",
      "target_language": "Vietnamese",
      "input": "그 제안은 겉보기에는 좋아도 막상 뚜껑을 열어 보면 문제가 한두 가지가 아니다.",
      "reference": "Đề xuất đó nhìn bề ngoài có vẻ tốt, nhưng khi xem xét kỹ thì vấn đề không chỉ có một hai chuyện.",
      "required_terms": [
        "đề xuất",
        "vấn đề"
      ],
      "forbidden_terms": [
        "nắp"
      ],
      "rubric": [
        "Renders the idiom naturally rather than mentioning a literal lid",
        "Preserves the contrast between appearance and closer inspection",
        "Conveys that there are many problems"
      ]
    },
    {
      "id": "text-06-placeholders",
      "difficulty": 6,
      "source_language": "French",
      "target_language": "Vietnamese",
      "input": "Si {{user_name}} n'a pas confirmé avant le 03/04/2026, n'effacez ni <draft_id> ni le dossier « À revoir ».",
      "reference": "Nếu {{user_name}} chưa xác nhận trước ngày 03/04/2026, đừng xóa <draft_id> hoặc thư mục « Cần xem lại ».",
      "required_terms": [
        "xác nhận",
        "đừng xóa",
        "thư mục"
      ],
      "required_exact": [
        "{{user_name}}",
        "<draft_id>",
        "03/04/2026"
      ],
      "rubric": [
        "Preserves both placeholders byte-for-byte",
        "Preserves the date without guessing month/day order",
        "Prohibits deleting either protected item"
      ]
    },
    {
      "id": "text-07-legal-scope",
      "difficulty": 7,
      "source_language": "Simplified Chinese",
      "target_language": "English",
      "input": "除非甲方在收到通知后的两个工作日内书面反对，否则不得视为其放弃任何权利。",
      "reference": "Unless Party A objects in writing within two business days after receiving notice, this must not be deemed a waiver of any rights.",
      "required_terms": [
        "Party A",
        "in writing",
        "two business days",
        "must not",
        "any rights"
      ],
      "rubric": [
        "Keeps the unless-condition scoped to a written objection",
        "Does not reverse the prohibition on treating silence as waiver",
        "Preserves the two-business-day window"
      ]
    },
    {
      "id": "text-08-gender-neutral",
      "difficulty": 8,
      "source_language": "Turkish",
      "target_language": "English",
      "input": "Deniz, Ekin'e yedeğin bozulduğunu söyledikten sonra ondan yalnızca 23.40'tan sonra değiştirilen dosyaları geri yüklemesini istedi.",
      "reference": "After Deniz told Ekin that the backup had failed, they asked them to restore only the files modified after 23:40.",
      "required_terms": [
        "Deniz",
        "Ekin",
        "backup",
        "only",
        "files"
      ],
      "required_exact": [
        "23:40"
      ],
      "forbidden_terms": [
        "he",
        "she",
        "his",
        "her"
      ],
      "rubric": [
        "Does not invent a gender for Deniz or Ekin",
        "Restores only files modified after 23:40",
        "Keeps the request directed from Deniz to Ekin"
      ]
    },
    {
      "id": "text-09-counterfactual",
      "difficulty": 9,
      "source_language": "Spanish",
      "target_language": "English",
      "input": "No fue hasta que dejó de llover que Marta se dio cuenta de que, si Luis no hubiera cerrado la ventana, los documentos se habrían mojado.",
      "reference": "It was not until it stopped raining that Marta realized that, if Luis had not closed the window, the documents would have gotten wet.",
      "required_terms": [
        "Marta",
        "Luis",
        "not until",
        "had not closed",
        "would have"
      ],
      "rubric": [
        "Preserves the not-until timing",
        "Preserves the unreal past condition",
        "Does not imply that the documents actually became wet"
      ]
    },
    {
      "id": "text-10-structured-constraints",
      "difficulty": 10,
      "source_language": "Simplified Chinese",
      "target_language": "Vietnamese",
      "input": "状态：**禁止部署**\n- 保持 ${BUILD_ID} 不变。\n- 仅恢复 UTC+9 23:40 之后修改的文件；不要恢复归档。\n- “可以”表示许可，不表示可能性。",
      "reference": "Trạng thái: **KHÔNG ĐƯỢC TRIỂN KHAI**\n- Giữ nguyên ${BUILD_ID}.\n- Chỉ khôi phục các tệp được sửa sau 23:40 UTC+9; không khôi phục tệp lưu trữ.\n- “Có thể” biểu thị sự cho phép, không phải khả năng.",
      "required_terms": [
        "KHÔNG ĐƯỢC TRIỂN KHAI",
        "Chỉ",
        "lưu trữ",
        "cho phép"
      ],
      "required_exact": [
        "**",
        "${BUILD_ID}",
        "23:40",
        "UTC+9"
      ],
      "required_exact_any": [
        [
          "“Có thể”",
          "\"Có thể\""
        ]
      ],
      "expected_line_count": 4,
      "rubric": [
        "Preserves the Markdown structure and placeholder",
        "Keeps the deployment prohibition emphatic",
        "Restores only post-23:40 files and explicitly excludes the archive",
        "Explains 可以 as permission rather than probability"
      ]
    }
  ],
