{
  "name": "screen-demo",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node ../scripts/ensure-rolldown-native.mjs",
    "prebuild": "node ../scripts/ensure-rolldown-native.mjs",
    "build": "tsc && vite build",
    "check:source-limits": "node scripts/verify_source_limits.mjs",
    "check:bundle-size": "node scripts/verify_bundle_limits.mjs",
    "lint": "eslint src tests vite.config.ts vitest.config.ts playwright.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:components": "vitest run tests/components",
    "test:e2e": "playwright test tests/e2e",
    "test:wry": "node tests/wry/ensure-windows-debug-build.mjs && playwright test tests/wry",
    "test:perf": "playwright test tests/perf",
    "test:perf:update": "SGT_UPDATE_PERF_BASELINE=1 playwright test tests/perf"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.5",
    "@rolldown/binding-win32-x64-msvc": "1.2.5"
  }
}
